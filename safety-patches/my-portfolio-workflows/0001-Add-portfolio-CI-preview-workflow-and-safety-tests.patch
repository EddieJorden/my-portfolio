+name: Deploy develop preview
+
+on:
+  push:
+    branches:
+      - develop
+
+permissions:
+  contents: write
+
+jobs:
+  deploy-preview:
+    runs-on: ubuntu-latest
+
+    steps:
+      - name: Checkout source
+        uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+
+      - name: Setup Node
+        uses: actions/setup-node@v4
+        with:
+          node-version: 20
+          cache: npm
+
+      - name: Install dependencies
+        run: npm ci
+
+      - name: Test
+        run: CI=true npm test -- --watchAll=false
+
+      - name: Build preview bundle
+        env:
+          PUBLIC_URL: /dev
+        run: npm run build
+
+      - name: Publish preview into gh-pages /dev
+        run: |
+          set -euo pipefail
+          git config user.name "github-actions[bot]"
+          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
+
+          workdir="$(mktemp -d)"
+          if git ls-remote --exit-code origin gh-pages >/dev/null 2>&1; then
+            git clone --branch gh-pages "https://x-access-token:${{ github.token }}@github.com/${{ github.repository }}.git" "$workdir"
+          else
+            git clone "https://x-access-token:${{ github.token }}@github.com/${{ github.repository }}.git" "$workdir"
+            cd "$workdir"
+            git checkout --orphan gh-pages
+            find . -mindepth 1 -maxdepth 1 ! -name .git -exec rm -rf {} +
+            touch .nojekyll
+            git add .nojekyll
+            git commit -m "Initialize gh-pages"
+            git push origin gh-pages
+          fi
+
+          cd "$workdir"
+          mkdir -p dev
+          find dev -mindepth 1 -maxdepth 1 -exec rm -rf {} +
+          cp -R "$GITHUB_WORKSPACE"/build/. dev/
+          touch .nojekyll
+          git add dev .nojekyll
+
+          if git diff --cached --quiet; then
+            echo "No preview changes to publish"
+            exit 0
+          fi
+
+          git commit -m "Deploy develop preview (${GITHUB_SHA::7})"
+          git push origin gh-pages
+
+      - name: Preview URL
+        run: echo "Preview should be available at https://eddiemoger.com/dev/ after Pages finishes serving the updated gh-pages branch."
