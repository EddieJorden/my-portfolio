+import React from 'react';
+import { render, screen } from '@testing-library/react';
+import App from '../App';
+
+jest.mock('react-tsparticles', () => ({
+  __esModule: true,
+  default: () => <div data-testid="particle-background" />,
+}));
+
+jest.mock('tsparticles', () => ({
+  loadFull: jest.fn(),
+}));
+
+const routeExpectations: Array<{ path: string; text: RegExp }> = [
+  { path: '/', text: /eddie moger/i },
+  { path: '/projects', text: /my projects/i },
+  { path: '/services', text: /professional services/i },
+  { path: '/services/workspace-domain-setup', text: /workspace \+ domain setup/i },
+  { path: '/services/openclaw-install-local', text: /openclaw install/i },
+  { path: '/services/hourly-ai-support', text: /hourly ai systems support/i },
+  { path: '/services/managed-hosting-ai-ops', text: /managed hosting/i },
+  { path: '/projects/custom-ai-agents', text: /custom ai agent setup/i },
+];
+
+describe('portfolio route smoke tests', () => {
+  afterEach(() => {
+    window.history.pushState({}, '', '/');
+  });
+
+  it.each(routeExpectations)('renders $path', ({ path, text }) => {
+    window.history.pushState({}, '', path);
+    render(<App />);
+    expect(screen.getAllByText(text).length).toBeGreaterThan(0);
+  });
+});
